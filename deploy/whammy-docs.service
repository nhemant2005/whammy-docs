[Unit]
Description=WhammyDocs FastAPI Application Service
After=network.target

[Service]
# The unprivileged user and group under which the service runs
User=whammy
Group=whammy

# Working directory where main.py lives
WorkingDirectory=/var/www/whammy-docs

# Path to the virtual environment's Uvicorn executable
ExecStart=/var/www/whammy-docs/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2

# Load environment variables (including DEEPSEEK_API_KEY) from the local .env
EnvironmentFile=/var/www/whammy-docs/.env

# Use a safe folder inside our project dir for session files to prevent system /tmp cleanups
Environment=WHAMMY_TMP_DIR=/var/www/whammy-docs/tmp

# Self-healing restart configuration
Restart=always
RestartSec=5

# Logging configuration
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whammy-docs

[Install]
WantedBy=multi-user.target
